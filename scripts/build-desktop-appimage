#!/usr/bin/env bash
set -euo pipefail

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

image=zealot-appimage-builder:ubuntu-22.04
user_id=$(id -u)
group_id=$(id -g)

docker build \
  --build-arg "USER_ID=$user_id" \
  --build-arg "GROUP_ID=$group_id" \
  --file apps/desktop/Dockerfile.appimage \
  --tag "$image" \
  .

docker run --rm \
  --env APPIMAGE_EXTRACT_AND_RUN=1 \
  --env NO_STRIP=true \
  --volume "$repo_root:/work" \
  --workdir /work \
  "$image" \
  npm run tauri:desktop:build --workspace @zealot/desktop -- --bundles appimage
